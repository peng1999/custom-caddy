{
	admin off
	auto_https off
}
http://127.0.0.1:{$CADDY_TEST_HTTP_PORT:8080} {
	bind 127.0.0.1
	respond "custom-caddy smoke test"
}
http://127.0.0.1:{$CADDY_TEST_JWT_PORT:8081} {
	bind 127.0.0.1
	route {
		jwtauth {
			sign_key Y3VzdG9tLWNhZGR5LWp3dC1zbW9rZS10ZXN0LWtleS0x
			sign_alg HS256
			from_header Authorization
			issuer_whitelist https://issuer.example.invalid/
			audience_whitelist https://mcp.example.invalid/mcp
		}
		respond "JWT accepted"
	}
}
